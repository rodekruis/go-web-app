enable-pre-post-scripts=true

# FontAwesome Pro Kit + Pro packages registry.
# The token is read at install time, so it must be exported in your shell/CI before running install.
@awesome.me:registry=https://npm.fontawesome.com/
@fortawesome:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=${FONTAWESOME_API_KEY}
